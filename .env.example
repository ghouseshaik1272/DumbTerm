# GLinux / GLab configuration
# Keep this file private. Never commit real secrets.
PORT=3000
NODE_ENV=production
DEBUG=FALSE

# Branding
SITE_TITLE=GLinux

# Public URL; update this to your deployed HTTPS URL before publishing
BASE_URL=http://localhost:3000

# REQUIRED: set a private numeric PIN before running Docker Compose
DUMBTERM_PIN=

# Authentication/session controls
LOCKOUT_TIME=15
MAX_SESSION_AGE=24

# Set this to your exact trusted GLab origin(s) before production.
# Example: ALLOWED_ORIGINS=https://learn.your-domain.example
ALLOWED_ORIGINS=

# true means simulated terminal; false means real shell
DEMO_MODE=false

# Docker-only options
ENABLE_STARSHIP=true
DUMBTERM_TZ=Asia/Kolkata
DUMBTERM_PORT=3000
DUMBTERM_SITE_TITLE=GLinux
DUMBTERM_BASE_URL=http://localhost:3000
DUMBTERM_CONFIG=./config
DUMBTERM_DATA_DIR=./data
DUMBTERM_LOCKOUT_TIME=15
DUMBTERM_MAX_SESSION_AGE=24
