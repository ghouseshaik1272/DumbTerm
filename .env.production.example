# Production settings for GLinux on a dedicated Ubuntu Docker VM
# Use linux.devopsbyghouse.co.in (or another subdomain you control).
GLINUX_DOMAIN=linux.devopsbyghouse.co.in

# REQUIRED: replace with a private numeric PIN before starting.
DUMBTERM_PIN=

# The browser terminal and GLab website origins. Add other exact trusted origins if needed.
ALLOWED_ORIGINS=https://learn.devopsbyghouse.co.in,https://linux.devopsbyghouse.co.in

DUMBTERM_TZ=Asia/Kolkata
DUMBTERM_LOCKOUT_TIME=15
DUMBTERM_MAX_SESSION_AGE=24
ENABLE_STARSHIP=true
